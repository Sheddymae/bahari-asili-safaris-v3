# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Supabase service role key — Project Settings → API → service_role (SECRET)
# Required by app/api/booking/route.ts to insert bookings server-side, bypassing RLS.
# NEVER prefix this with NEXT_PUBLIC_ and never expose it to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (https://resend.com) — used to send booking confirmation + review-request emails
EMAIL_API_KEY=your-resend-api-key
EMAIL_SENDER="Bahari Asili Safaris <onboarding@resend.dev>"
EMAIL_TO=sheddymae02@gmail.com

# Set this to your deployed domain once known (used for metadataBase / OG image URLs)
NEXT_PUBLIC_SITE_URL=https://bahari-asili-safaris.vercel.app

# --- Admin dashboard (/admin) ---
# Username used to log in at /admin/login
ADMIN_USERNAME=Admin

# Hashed password — NEVER put the plaintext password here.
# This hash below corresponds to "Bahari.123" (the password from the brief).
# To generate a hash for a different password, run:
#   node -e "const{scryptSync,randomBytes}=require('crypto');const p='YOUR_PASSWORD';const s=randomBytes(16).toString('hex');console.log(s+':'+scryptSync(p,s,64).toString('hex'))"
ADMIN_PASSWORD_HASH=a63027d6046ef719f89e279fe35b0729:5535945dfabb09e4a03974fdae33818be20d8ee1ab6ba99bd1f462f9a3402c7ebdf7e721e7ff0e1e1a436d16d2b23e89b1cac93d6d524bd1ee58b96e9d34036e

# Long random string used to sign admin session cookies (JWT). Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The example below is a placeholder — replace it before deploying.
ADMIN_SESSION_SECRET=3ebd753d6d7e1beb3e1b172b052c0e5284441e70a929cb6925cf2e73e97fdf2f
